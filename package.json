{
  "name": "tagwerk",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "e2e": "node e2e/flow.mjs",
    "build:docs": "tsc --noEmit && vite build --outDir docs --emptyOutDir && node -e \"require('fs').writeFileSync('docs/.nojekyll','')\""
  },
  "dependencies": {
    "idb": "^8.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.2",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "fake-indexeddb": "^6.2.8",
    "typescript": "5.9",
    "vite": "^6.4.6",
    "vitest": "^5.1.2"
  },
  "engines": {
    "node": ">=18.18"
  }
}
